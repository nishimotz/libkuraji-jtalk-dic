# Normalize line endings to LF for text files in this repository.
# Repository-local core.autocrlf=false is also set so Windows checkouts
# keep LF and do not introduce meaningless CRLF diffs.

*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.def text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.bat text eol=lf
*.cmd text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf
